# Salin file ini menjadi .env.local lalu isi nilainya.
# Supabase Dashboard → Project Settings → API (atau "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # atau "anon public key"

# Hanya untuk script import (JANGAN dipasang di Vercel)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx                   # atau "service_role key"

# Kunci enkripsi data sensitif (NIK, KK, password NVR). Buat dengan: npm run gen-key
# SIMPAN BAIK-BAIK — jika hilang, data sensitif tidak bisa dibuka lagi.
SECRETS_KEY=
